# SpacetimeDB connection. Copy to .env (gitignored). Used by `just` recipes and baked into the
# client at build time.
SPACETIMEDB_URI=http://127.0.0.1:3000
SPACETIMEDB_MODULE=monster-master

# Client logging. Bevy's LogPlugin reads RUST_LOG: `game` crate at trace+, everything else warn+.
RUST_LOG=warn,game=trace
